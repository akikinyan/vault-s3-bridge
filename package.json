{
	"name": "vault-s3-bridge",
	"version": "0.0.1",
	"description": "Manage Obsidian attachments on AWS S3 and S3-compatible storage, with IAM Role authentication and private previews.",
	"main": "main.js",
	"type": "module",
	"private": true,
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "npm run typecheck && node esbuild.config.mjs production && node scripts/check-bundle.mjs",
		"typecheck": "tsc --noEmit",
		"lint": "eslint .",
		"test": "vitest run",
		"test:watch": "vitest",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"smoke:aws": "tsx scripts/smoke-aws.ts",
		"check:local-values": "node scripts/check-local-values.mjs",
		"smoke:preview": "tsx scripts/smoke-preview.ts",
		"smoke:upload": "tsx scripts/smoke-upload.ts"
	},
	"keywords": [
		"obsidian",
		"s3"
	],
	"license": "MIT",
	"engines": {
		"node": ">=22"
	},
	"devDependencies": {
		"@codemirror/state": "6.7.6",
		"@codemirror/view": "6.43.13",
		"@eslint/js": "^9.39.5",
		"@smithy/types": "4.19.0",
		"@types/markdown-it": "14.2.0",
		"@types/node": "^22.20.5",
		"esbuild": "^0.28.2",
		"eslint": "^9.39.5",
		"eslint-plugin-obsidianmd": "^0.4.2",
		"fast-check": "4.10.2",
		"globals": "^17.13.0",
		"happy-dom": "21.0.1",
		"jiti": "^2.7.0",
		"markdown-it": "15.0.2",
		"obsidian": "^1.14.4",
		"proxy": "^4.1.0",
		"tsx": "^4.23.15",
		"typescript": "~5.9",
		"typescript-eslint": "^8.71.2",
		"vitest": "^5.0.4"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "3.1151.0",
		"@aws-sdk/client-sts": "3.1151.0",
		"@aws-sdk/credential-provider-sso": "3.973.18",
		"@smithy/node-http-handler": "4.12.1",
		"@smithy/shared-ini-file-loader": "4.7.2",
		"agent-base": "9.0.0",
		"entities": "8.1.0",
		"https-proxy-agent": "9.1.0"
	}
}
